{
  "rules": {
    ".read": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
    ".write": "auth != null && auth.token.email === 'ADMIN_EMAIL_HERE'",
    "ingredients": {
      "$id": {
        ".validate": "newData.hasChildren(['name', 'unit', 'packSize', 'packPrice']) && newData.child('packSize').isNumber() && newData.child('packSize').val() > 0 && newData.child('packPrice').isNumber() && newData.child('unit').val().matches(/^(g|ml|pc)$/)"
      }
    },
    "recipes": {
      "$id": {
        ".validate": "newData.hasChildren(['name', 'baseFlour']) && newData.child('baseFlour').isNumber()"
      }
    }
  }
}
