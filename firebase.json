{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "predeploy": [
      "yarn build"
    ]
  },
  "database": {
    "rules": "database.rules.json",
    "predeploy": [
      "sh -c \"if grep -q ADMIN_EMAIL_HERE database.rules.json; then echo 'Put your admin email in database.rules.json before deploying.'; exit 1; fi\""
    ]
  }
}
